# Copiar a .env (NUNCA subir a git, ya está en .gitignore) y llenar con
# las credenciales que te comparta el administrador del equipo por un
# canal privado (WhatsApp/Discord), no por el repositorio.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# Conexión a la base PostgreSQL compartida (Supabase > Project Settings >
# Database > Connection pooling > Session pooler / URI).
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
