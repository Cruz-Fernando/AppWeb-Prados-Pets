# Copia este archivo a .env y completa los valores (NUNCA subas .env al repo).

# --- Base de datos (PostgreSQL / Supabase) ---
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Solo producción (Railway) ---
# Debe estar definido en producción; si falta, la app no arranca (a propósito).
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
# Dominios separados por coma, ej: prados-pets-canina.up.railway.app
DJANGO_ALLOWED_HOSTS=
# Orígenes confiables para CSRF, con https://, separados por coma
CSRF_TRUSTED_ORIGINS=
